{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@constants": ["./src/constants/index"],
      "@lib/*": ["./src/lib/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@services/*": ["./src/services/*"],
      "@components/*": ["./src/components/*"],
      "@types": ["./src/types/index"]
    }
  },
  "exclude": ["node_modules", "supabase"]
}
